# --- Raws (archivos de origen: datos clínicos — NUNCA versionar) ---
raw/**

# --- PII local: NO versionar ---
patients/patient_registry.csv

# --- Intermedios generados (bronze / silver / events / states / gold) ---
bronze/**
silver/**
events/**
states/**
gold/**
!bronze/.gitkeep
!silver/.gitkeep
!events/.gitkeep
!states/.gitkeep
!gold/.gitkeep
!gold/MANIFEST.json
!gold/nights_columns.json
!gold/nights_columns_descriptions.csv

# --- Modelos persistidos (etapa 3b) ---
# POLÍTICA TESIS: los PKL son canon congelado — no re-fitear (ver README.md).
# Se versionan TODOS los PKL de canon porque son pequeños (<2 MB c/u) y
# un jurado que clone el repo necesita los modelos para re-correr NB01–NB08.
# Si el pipeline crece y los PKL se vuelven pesados, migrar a Git LFS.
models/*.pkl
!models/edo_morphotype_curve_kmeans.pkl
!models/pac_states_s_kmeans.pkl
!models/pac_states_m_kmeans.pkl
!models/pac_states_l_kmeans.pkl
!models/nb05_traj_kmeans.pkl
!models/nb06_event_lgbm.pkl
!models/nb06_night_lr.pkl
!models/.gitkeep

# --- Reportes y logs ---
reports/**
!reports/.gitkeep
